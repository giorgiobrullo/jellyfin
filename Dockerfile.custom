# The web client, from the jellyfin-web fork (branch custom-patches-12, on the web release that
# matches the server below, v12.2): progressive ASS subtitles (src/plugins/htmlVideoPlayer/
# progressiveAss.js) need the server's Subtitles/{index}/Progressive endpoint and vice versa.
# Pinned to a commit: bump WEB_COMMIT with every web change, and rebase the branch onto the new
# web release tag whenever the base image below moves to a new release.
FROM node:24-bookworm AS web
ARG WEB_REPO=https://github.com/giorgiobrullo/jellyfin-web.git
ARG WEB_COMMIT=d89c28d84b3dd011a05731090e0256ae785ad71e
WORKDIR /web
RUN git init -q . \
 && git fetch -q --depth 1 "$WEB_REPO" "$WEB_COMMIT" \
 && git checkout -q FETCH_HEAD \
 && npm ci --no-audit --no-fund \
 && npm run build:production

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
# Every assembly this branch patches, each built into its own directory: an assembly the image
# does not replace runs the stock code, whatever the branch says (the search fix in Jellyfin.Api
# and the session manager registration the subtitle extraction needs were both missing so).
RUN dotnet build MediaBrowser.MediaEncoding/MediaBrowser.MediaEncoding.csproj -c Release -o /build/encoding \
 && dotnet build Emby.Server.Implementations/Emby.Server.Implementations.csproj -c Release -o /build/implementations \
 && dotnet build Jellyfin.Api/Jellyfin.Api.csproj -c Release -o /build/api -p:Version=24.4.0.0

# The patched assemblies replace the stock ones, so they have to be built from the
# exact Jellyfin release the base image ships. This branch sits on v12.2 and
# the digest below is hotio's `release` tag at 12.2 (2026-10-08): bump both
# together, never one without the other. A new patch in another project needs
# its assembly added here. Jellyfin.Api does not compile SharedVersion.cs: the
# release build gives it its own version (24.4.0.0 in 12.2, see the stock DLL's
# version resource) and the other assemblies reference that one, so it has to be
# built with it or the server does not start (FileNotFoundException at startup).
# Test a new image with `docker run` before it replaces the running one.
FROM ghcr.io/hotio/jellyfin:release@sha256:f267a94bc66983073f20b9765291dd0f72b48f49aac9bc08ccda778079d57a9c
COPY --from=build /build/encoding/MediaBrowser.MediaEncoding.dll /usr/lib/jellyfin/bin/MediaBrowser.MediaEncoding.dll
COPY --from=build /build/implementations/Emby.Server.Implementations.dll /usr/lib/jellyfin/bin/Emby.Server.Implementations.dll
COPY --from=build /build/api/Jellyfin.Api.dll /usr/lib/jellyfin/bin/Jellyfin.Api.dll
# The whole web client is replaced, so no chunk of the stock build is left behind; ui/ is not
# part of it (in k3s it is the abyss-spotlight theme mounted over this path).
RUN rm -rf /usr/share/jellyfin/web && mkdir -p /usr/share/jellyfin/web
COPY --from=web /web/dist/ /usr/share/jellyfin/web/
